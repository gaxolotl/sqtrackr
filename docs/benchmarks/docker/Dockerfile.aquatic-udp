FROM rust:bookworm AS builder
RUN apt-get update && apt-get install -y cmake build-essential pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/greatest-ape/aquatic.git /src
WORKDIR /src
RUN cargo build --release -p aquatic_udp

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /src/target/release/aquatic_udp /usr/local/bin/aquatic_udp
COPY docs/benchmarks/docker/aquatic-udp-bench.docker.toml /etc/aquatic-udp.toml
EXPOSE 3100/udp
ENTRYPOINT ["aquatic_udp"]
CMD ["-c", "/etc/aquatic-udp.toml"]
